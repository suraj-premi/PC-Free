# PC-Free Windows 10 settings
# Run `./pcfree setup`; it creates .env and generates a strong password.

COMPOSE_PROJECT_NAME=pc-free
WINDOWS_IMAGE=ghcr.io/dockur/windows:6.06

# Windows login and web-viewer login
WINDOWS_USERNAME=PCFree
WINDOWS_PASSWORD=change-me

# Windows locale
WINDOWS_LANGUAGE=en-US
WINDOWS_REGION=en-US
WINDOWS_KEYBOARD=en-US

# VM resources (minimum host: 2 CPU, 4 GB RAM, 32 GB free disk)
WINDOWS_RAM_SIZE=4G
WINDOWS_CPU_CORES=2
WINDOWS_DISK_SIZE=64G
WINDOWS_AUDIO=Y
WINDOWS_WEB_AUTH=Y

# Bind to localhost by default so Windows/RDP is not exposed to the internet.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8006
RDP_BIND_ADDRESS=127.0.0.1
RDP_PORT=3389

# Persistent VM disk and host/guest shared folder
WINDOWS_STORAGE_PATH=./windows
WINDOWS_SHARED_PATH=./shared
